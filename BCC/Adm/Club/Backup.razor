@page "/backup/{Data}"
@rendermode InteractiveServer
<style>
    .mod {
        width: 400px;
    }
</style>

        <div class="flex-column mod mod-box">
            <h4 class="d-flex justify-content-center">@Title</h4>
            <EditForm Model="Model" FormName="Backup">
                <div class="form-group d-flex flex-column">
                    <br />
                <input type="text" @bind-value="InputText" @bind-value:event="oninput" style="height:25px;" placeholder="Text Here" @onkeydown="keyDownText"/>
                <br />
                    <select @bind="Model">
                        @if (Files.Count != 0)
                        {
                            foreach (string f in Files)
                            {
                                <option value="@f">@f</option>
                            }
                        }
                    </select>
                </div><br />
                <button type="submit" class="btn btn-sm @btnClass" @onclick="Submit">Submit</button>
            </EditForm>
        </div>




