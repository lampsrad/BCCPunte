

<style>
    .mod {
        width: 400px;
    }

    .linker {
        color: dodgerblue;
    }

        .linker:hover {
            color: red;
        }
</style>
<h3>@Salon.SalonMaster.SalonName</h3>
<button class="btn btn-sm btn-primary" @onclick="close">Back</button>
<hr />
<div class="d-flex flex-column">
    <div class="mod mod-box">
        <EditForm Model="Salon" OnValidSubmit="Submitted">
            <div class="form-group">
            </div>
            <div class="form-group">
                <label class="control-label">Acceptance</label>
                <InputNumber @bind-Value="Salon.Acceptance" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Com</label>
                <InputNumber @bind-Value="Salon.Com" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Points</label>
                <InputNumber @bind-Value="Salon.Points" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Judge</label>
                <InputNumber @bind-Value="Salon.Judge" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Award</label>
                <InputText @bind-Value="Salon.Award" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Submit" class="btn btn-primary"/>
            </div>
        </EditForm>
    </div>
</div>
<br />



