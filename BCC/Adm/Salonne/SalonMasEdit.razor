
<style>
    .mod {
        width: 500px;
    }
</style>

<h3>Salon Edit</h3>

<div class="d-flex flex-column">
    <div class="mod mod-box">
        <EditForm Model="SalonMaster">
            <div class="form-group">
                <label class="control-label text-success">@SalonMaster.SalonName</label>
            </div>
            <div class="form-group">
                <label class="control-label">Salon Name(Alias)</label>
                <InputText @bind-Value="SalonMaster.Alias" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Date</label>
                <InputDate @bind-Value="SalonMaster.Date" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">International</label>
                <InputCheckbox @bind-Value="SalonMaster.International" class="form-check" />
            </div> <div class="form-group">
                <label class="control-label">Imported</label>
                <InputCheckbox @bind-Value="SalonMaster.Imported" class="form-check" />
            </div>
            <div class="form-group">
                <button type="submit" value="Submit" class="btn btn-sm btn-primary" @onclick="Submitted">Submit</button>
                <button class="btn btn-sm btn-primary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
     
    </div>
</div>


